# Public Site URLs
NEXT_PUBLIC_HAMMAD_SITE_URL=https://hammad.yzeducationalservices.com
NEXT_PUBLIC_YZ_SITE_URL=https://yzeducationalservices.com

# PayPro V2 Gateway Configuration (add real values only in .env.local / host secrets)
# Demo/Sandbox Base URL: https://demoapi.paypro.com.pk
# Production Base URL: must be provided by PayPro onboarding; never infer it.
PAYPRO_BASE_URL=https://demoapi.paypro.com.pk
PAYPRO_CLIENT_ID=your_paypro_client_id_here
PAYPRO_CLIENT_SECRET=your_paypro_client_secret_here
PAYPRO_MERCHANT_ID=your_paypro_merchant_id_here
PAYPRO_ENV=sandbox

# PayPro server callback credentials
PAYPRO_CALLBACK_USERNAME=your_callback_username_here
PAYPRO_CALLBACK_PASSWORD=your_callback_password_here

# Durable payment storage required in production
# POSTGRES_URL=postgres://user:password@host:5432/hammad_db
