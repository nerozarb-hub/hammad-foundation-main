# Public site addresses only. Never prefix payment/database secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_HAMMAD_SITE_URL=https://hammad.yzeducationalservices.com
NEXT_PUBLIC_YZ_SITE_URL=https://yzeducationalservices.com

# Exact HTTPS browser origin used for server-side origin and cookie checks.
APP_URL=https://hammad.yzeducationalservices.com

# Confirmed production host. Live requests stay locked until explicit approval.
PAYPRO_ENV=production
PAYPRO_BASE_URL=https://api.paypro.com.pk
PAYPRO_LIVE_REQUESTS_ENABLED=false

# Server-side secrets. Supply privately through the host or ignored .env.local.
PAYPRO_CLIENT_ID=
PAYPRO_CLIENT_SECRET=
PAYPRO_MERCHANT_ID=
PAYPRO_CALLBACK_USERNAME=
PAYPRO_CALLBACK_PASSWORD=

# Restricted runtime role, using the provider-confirmed pooled endpoint.
# Supabase project: dmbtbothpflvxzizsczs (ap-northeast-1).
# Use the Supabase Connect dialog to obtain the pooled runtime URL and direct
# migration URL. Never commit either value.
DATABASE_URL=
# Administrative/direct connection for operator migrations only; not deployed to runtime.
DATABASE_MIGRATION_URL=
# Optional provider CA certificate. Certificate verification is always enabled.
DATABASE_CA_CERT=
